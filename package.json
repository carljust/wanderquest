  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:phone": "expo start --go --tunnel --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "export:web": "expo export --platform web --output-dir dist/web --max-workers 2",
    "export:native": "expo export --platform ios --platform android --output-dir dist/native --max-workers 2",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:web": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:generate": "node scripts/generate-seed.mjs",
    "test:database": "node scripts/test-database.mjs",
    "check:release": "node scripts/check-release.mjs",
    "start:dev": "expo start --dev-client --tunnel --clear",
    "map:generate": "node scripts/generate-map-runtime.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "packageManager": "npm@11.9.0"
}
