# Intentionally public client configuration, never a service-role credential.
EXPO_PUBLIC_SUPABASE_URL=https://rxkvdixavsrakbtmnsao.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Development bundles only. Release exports always disable practice mode.
EXPO_PUBLIC_ENABLE_DEV_MODE=true
# Optional: own Android development/release build; not required by Expo Go.
# Restrict this Maps key to the Android package and signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
